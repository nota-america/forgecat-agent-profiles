{
  "mcpServers": {
    "mcp-search": {
      "type": "stdio",
      "command": "node",
      "args": [
        "-e",
        "const fs=require('fs'),p=require('path'),c=require('child_process');const workspaceRoot=process.cwd();const profileDir=process.env.FORGECAT_PROFILE_DIR||p.join(workspaceRoot,'.forgecat','profiles','@forgecat','thedotmack_claude-mem_plugin');const explicit=process.env.FORGECAT_PROFILE_DIR?[p.join(process.env.FORGECAT_PROFILE_DIR,'skills','how-it-works','runtime')]:[];const candidates=[...explicit,p.join(workspaceRoot,'.claude','skills','how-it-works','runtime'),p.join(workspaceRoot,'.agents','skills','how-it-works','runtime'),p.join(workspaceRoot,'.cursor','skills','how-it-works','runtime'),p.join(profileDir,'skills','how-it-works','runtime'),p.join(process.env.HOME||'','.forgecat','profiles','@forgecat','thedotmack_claude-mem_plugin','skills','how-it-works','runtime')];for(const runtimeRoot of candidates){if(!fs.existsSync(p.join(runtimeRoot,'scripts','mcp-server.cjs'))) continue;const child=c.spawn(process.execPath,[p.join(runtimeRoot,'scripts','mcp-server.cjs')],{stdio:'inherit',cwd:workspaceRoot,env:{...process.env,FORGECAT_PROFILE_DIR:profileDir,CLAUDE_PLUGIN_ROOT:runtimeRoot,PLUGIN_ROOT:runtimeRoot,CLAUDE_MEM_MODES_DIR:p.join(runtimeRoot,'modes')}});for(const sig of ['SIGTERM','SIGINT','SIGHUP']) process.on(sig,()=>{try{child.kill(sig)}catch{}});child.on('exit',(code,sig)=>{if(sig){try{process.kill(process.pid,sig)}catch{process.exit(1)}}else{process.exit(code==null?0:code)}});return;}process.stderr.write('claude-mem: installed MCP server not found\\n');process.exit(1);"
      ]
    }
  }
}
