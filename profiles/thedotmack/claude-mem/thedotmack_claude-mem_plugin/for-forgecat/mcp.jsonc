{
  "mcpServers": {
    "mcp-search": {
      "type": "stdio",
      "command": "node",
      "args": [
        "-e",
        "const fs=require('fs'),p=require('path'),c=require('child_process');const cwd=process.cwd();const explicit=[process.env.FORGECAT_PROFILE_DIR].filter(Boolean);const candidates=[...explicit,p.join(cwd,'.forgecat','profiles','@forgecat','thedotmack_claude-mem_plugin'),p.join(process.env.HOME||'','.forgecat','profiles','@forgecat','thedotmack_claude-mem_plugin')];for(const dir of candidates){if(!fs.existsSync(p.join(dir,'skills/how-it-works/runtime','scripts','mcp-server.cjs'))) continue;const pluginRoot=p.join(dir,'skills/how-it-works/runtime');const child=c.spawn(process.execPath,[p.join(pluginRoot,'scripts','mcp-server.cjs')],{stdio:'inherit',cwd:dir,env:{...process.env,FORGECAT_PROFILE_DIR:dir,CLAUDE_PLUGIN_ROOT:pluginRoot,PLUGIN_ROOT:pluginRoot,CLAUDE_MEM_MODES_DIR:p.join(pluginRoot,'modes')}});for(const sig of ['SIGTERM','SIGINT','SIGHUP']) process.on(sig,()=>{try{child.kill(sig)}catch{}});child.on('exit',(code,sig)=>{if(sig){try{process.kill(process.pid,sig)}catch{process.exit(1)}}else{process.exit(code==null?0:code)}});return;}process.stderr.write('claude-mem: installed MCP server not found\\n');process.exit(1);"
      ]
    }
  }
}
