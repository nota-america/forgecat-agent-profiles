{
  "hooks": {
    "SessionStart": [
      {
        "_forgecat": "@forgecat/openai_codex-plugin-cc_codex#codex-companion-session-start",
        "hooks": [
          {
            "type": "command",
            "command": "./.forgecat/profiles/@forgecat/openai_codex-plugin-cc_codex/hooks/_fc_wrap.sh claude-code session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "_forgecat": "@forgecat/openai_codex-plugin-cc_codex#codex-companion-session-end",
        "hooks": [
          {
            "type": "command",
            "command": "./.forgecat/profiles/@forgecat/openai_codex-plugin-cc_codex/hooks/_fc_wrap.sh claude-code session-end.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "_forgecat": "@forgecat/openai_codex-plugin-cc_codex#codex-companion-stop-review-gate",
        "hooks": [
          {
            "type": "command",
            "command": "./.forgecat/profiles/@forgecat/openai_codex-plugin-cc_codex/hooks/_fc_wrap.sh claude-code stop-review-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}