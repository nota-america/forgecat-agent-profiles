      {
        "_forgecat": "@forgecat/small-business-agent#smb-routing-nudge",
        "command": ".forgecat/profiles/@forgecat/small-business-agent/hooks/_fc_wrap.sh cursor smb-routing-nudge.js",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "_forgecat": "@forgecat/small-business-agent#smb-stop-checkpoint",
        "command": ".forgecat/profiles/@forgecat/small-business-agent/hooks/_fc_wrap.sh cursor smb-stop-checkpoint.js",
        "timeout": 5
      }
    ]
  }
}
