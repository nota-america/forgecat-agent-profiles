{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "_forgecat": "@forgecat/small-business-agent-team#smb-session-context",
        "command": ".forgecat/profiles/@forgecat/small-business-agent-team/hooks/_fc_wrap.sh cursor smb-session-start.js",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "_forgecat": "@forgecat/small-business-agent-team#smb-routing-nudge",
        "command": ".forgecat/profiles/@forgecat/small-business-agent-team/hooks/_fc_wrap.sh cursor smb-routing-nudge.js",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "_forgecat": "@forgecat/small-business-agent-team#smb-stop-checkpoint",
        "command": ".forgecat/profiles/@forgecat/small-business-agent-team/hooks/_fc_wrap.sh cursor smb-stop-checkpoint.js",
        "timeout": 5
      }
    ]
  }
}

